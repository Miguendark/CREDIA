# =============================================================================
# NEXA — Variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local (ni ningún archivo con secretos) al repositorio.
# =============================================================================

# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Service role key: SOLO para scripts de servidor (seed, migraciones).
# Tiene permisos totales y omite RLS. Nunca exponerla al navegador
# ni usar el prefijo NEXT_PUBLIC_ en esta variable.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública del sitio (usada para construir enlaces de recuperación de contraseña)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
